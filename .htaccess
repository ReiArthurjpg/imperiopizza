<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the URL starts with /api, route it to the backend
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^(.*)$ backend/public/index.php [L,QSA]
    
    # Otherwise, route everything else to frontend
    RewriteCond %{REQUEST_URI} !^/frontend/public/
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ frontend/public/$1 [L,QSA]
</IfModule>